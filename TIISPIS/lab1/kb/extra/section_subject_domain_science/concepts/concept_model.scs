concept_model
<- sc_node_class;
<- concept_wit_entity;
=> nrel_main_idtf:
	[Модель] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Model] (* <- lang_en;; *);
=> nrel_note:
	[Упрощённое представление объекта или процесса] (* <- lang_ru;; *);
=> nrel_definition:
    [Упрощённое представление объекта или процесса] (* <- lang_ru;; *);
<= nrel_subdividing: 
	...
   (*
		<- sc_node_tuple;;
		-> ..model_atom;;
		-> ..model_standard;;
   *);;

..model_atom
=> nrel_main_idtf:
	[Модель атома] (* <- lang_ru;; *);;

..model_standard
=> nrel_main_idtf:
	[Стандартная модель] (* <- lang_ru;; *);;
