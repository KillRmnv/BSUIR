@if = [* 
	_message 
		<-_ concept_message;
		<-_ concept_question_discovery;
		_-> rrel_entity:: _entity;;
	_entity <-_ concept_wit_entity;;
*];;

@then = [* 
	_message _=> nrel_reply:: _reply_message;;
	_reply_message
		<-_ concept_atomic_message;;
*];;

lr_answer_discovery
<- concept_answer_on_standard_message_rule;
<- concept_answer_on_standard_message_rule_priority_1;
=> nrel_answer_pattern:
	{ rrel_1: concept_phrase_discovery; rrel_1: concept_phrase_discovery_template };
<- rrel_main_key_sc_element: (@if => @then)
	(* <- nrel_implication;; *);;

atomic_logical_formula
-> @if;
-> @then;;
