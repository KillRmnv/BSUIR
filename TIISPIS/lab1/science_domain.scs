// ============================================
// Предметная область "Наука"
// Science Domain Ontology
// ============================================

// ============================================
// КЛАССЫ (абсолютные понятия)
// ============================================

concept_science
<- sc_node_class;
=> nrel_main_idtf:
	[Наука] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Science] (* <- lang_en;; *);
=> nrel_note:
	[Систематизированная деятельность человека, направленная на развитие знаний о мире] (* <- lang_ru;; *);;

concept_natural_science
<- sc_node_class;
<= nrel_inclusion: concept_science;
=> nrel_main_idtf:
	[Естественная наука] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Natural science] (* <- lang_en;; *);
=> nrel_note:
	[Наука, изучающая природные явления и законы] (* <- lang_ru;; *);;

