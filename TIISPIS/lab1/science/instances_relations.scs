// ============================================
// СВЯЗИ между экземплярами
// ============================================

// --- Отрасли науки ---
concept_physics <- nrel_branch_of concept_natural_science;;
concept_chemistry <- nrel_branch_of concept_natural_science;;
concept_biology <- nrel_branch_of concept_natural_science;;
concept_mathematics <- nrel_branch_of concept_formal_science;;
concept_informatics <- nrel_branch_of concept_formal_science;;
concept_engineering <- nrel_branch_of concept_applied_science;;
concept_medical_science <- nrel_branch_of concept_applied_science;;

// --- Учёные исследуют области науки ---
isaac_newton <- nrel_researches concept_physics;;
albert_einstein <- nrel_researches concept_physics;;
marie_curie <- nrel_researches concept_chemistry;;
charles_darwin <- nrel_researches concept_biology;;
alan_turing <- nrel_researches concept_informatics;;
dmitri_mendeleev <- nrel_researches concept_chemistry;;
louis_pasteur <- nrel_researches concept_biology;;
max_planck <- nrel_researches concept_physics;;
niels_bohr <- nrel_researches concept_physics;;

// --- Учёные сделали открытия ---
isaac_newton <- nrel_author_of discovery_gravity;;
albert_einstein <- nrel_author_of discovery_electromagnetic_induction;;
louis_pasteur <- nrel_author_of discovery_penicillin;;
dmitri_mendeleev <- nrel_author_of discovery_periodic_table;;

// --- Учёные приписаны к учреждениям ---
isaac_newton <- nrel_affiliated mit;;
albert_einstein <- nrel_affiliated cern;;
alan_turing <- nrel_affiliated mit;;
max_planck <- nrel_affiliated max_planck_institute;;
niels_bohr <- nrel_affiliated cern;;

// --- Теории основаны на гипотезах ---
theory_of_relativity <- nrel_based_on higgs_hypothesis;;
quantum_mechanics <- nrel_based_on string_theory_hypothesis;;

// --- Теории объясняют законы ---
theory_of_relativity <- nrel_explains newton_laws;;
quantum_mechanics <- nrel_explains thermodynamics_laws;;

// --- Эксперименты верифицируют гипотезы ---
experiment_double_slit <- nrel_verifies higgs_hypothesis;;
experiment_double_slit <- nrel_verifies string_theory_hypothesis;;

// --- Эксперименты проводились учёными ---
experiment_double_slit <- nrel_conducted_by isaac_newton;;
experiment_miller_urey <- nrel_conducted_by louis_pasteur;;

// --- Учёные применяют методы ---
isaac_newton <- nrel_applies_method mathematical_modeling;;
albert_einstein <- nrel_applies_method mathematical_modeling;;
louis_pasteur <- nrel_applies_method experimental_method;;
charles_darwin <- nrel_applies_method comparative_method;;

// --- Парадигмы определяют теории ---
paradigm_classical <- nrel_defines theory_of_relativity;;
paradigm_quantum <- nrel_defines quantum_mechanics;;

// --- Парадигмы заменяют друг друга ---
paradigm_quantum <- nrel_replaces paradigm_classical;;

// --- Учёные опубликованы в журналах ---
isaac_newton <- nrel_published_in nature_journal;;
albert_einstein <- nrel_published_in science_journal;;
max_planck <- nrel_published_in physical_review;;
