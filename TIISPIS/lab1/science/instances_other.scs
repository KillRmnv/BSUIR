// --- Конференции ---

conference_icpc
<- concept_conference;
=> nrel_main_idtf:
	[ICPC] (* <- lang_en;; *);
=> nrel_note:
	[Международная олимпиада по программированию] (* <- lang_ru;; *);;

conference_neurips
<- concept_conference;
=> nrel_main_idtf:
	[NeurIPS] (* <- lang_en;; *);
=> nrel_note:
	[Конференция по нейронным сетям и обработке информации] (* <- lang_ru;; *);;

// --- Диссертации ---

dissertation_phd
