section_subject_domain_science
    => nrel_main_idtf:
        [Раздел. Предметная область "Наука"] (* <- lang_ru;; *);
<- sc_node_class;
<- atomic_section;;

section_subject_domain_science = [* subject_domain_science
    => nrel_main_idtf: 
        [Предметная область "Наука"] (* <- lang_ru;; *);
    <- subject_domain;
    -> rrel_maximum_studied_object_class:
        concept_science;
    -> rrel_explored_relation:
        nrel_branch_of;
        nrel_researches;
        nrel_conducted_by;
        nrel_author_of;
        nrel_published_in;
        nrel_affiliated;
        nrel_discovered;
        nrel_applies_method;
        nrel_verifies;
        nrel_based_on;
        nrel_explains;
        nrel_defines;
        nrel_replaces;
        nrel_discovered_by;
    -> rrel_not_maximum_studied_object_class:
        concept_human_science;
        concept_patent;;
*];;
