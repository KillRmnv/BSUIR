// ============================================
// ЭКЗЕМПЛЯРЫ: Научные законы
// ============================================

newton_laws
<- concept_law;
=> nrel_main_idtf:
	[Законы Ньютона] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Newton's laws] (* <- lang_en;; *);
=> nrel_note:
	[Три закона классической механики] (* <- lang_ru;; *);;

thermodynamics_laws
<- concept_law;
=> nrel_main_idtf:
	[Законы термодинамики] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Laws of thermodynamics] (* <- lang_en;; *);
=> nrel_note:
	[Законы, описывающие тепловые явления] (* <- lang_ru;; *);;

periodic_law
<- concept_law;
=> nrel_main_idtf:
	[Периодический закон] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Periodic law] (* <- lang_en;; *);
=> nrel_note:
	[Закон, установленный Менделеевым] (* <- lang_ru;; *);;
