experiment_double_slit
<- concept_experiment;
=> nrel_main_idtf:
	[Опыт со щелью] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Double-slit experiment] (* <- lang_en;; *);
=> nrel_note:
	[Классический эксперимент по квантовой механике] (* <- lang_ru;; *);;

experiment_miller_urey
<- concept_experiment;
=> nrel_main_idtf:
	[Эксперимент Миллера — Юри] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Miller-Urey experiment] (* <- lang_en;; *);
=> nrel_note:
	[Эксперимент по синтезу аминокислот] (* <- lang_ru;; *);;
