experimental_method
<- concept_method;
=> nrel_main_idtf:
	[Экспериментальный метод] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Experimental method] (* <- lang_en;; *);
=> nrel_note:
	[Метод исследования, основанный на проведении экспериментов] (* <- lang_ru;; *);;

mathematical_modeling
<- concept_method;
=> nrel_main_idtf:
	[Математическое моделирование] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Mathematical modeling] (* <- lang_en;; *);
=> nrel_note:
	[Метод исследования с помощью математических моделей] (* <- lang_ru;; *);;

comparative_method
<- concept_method;
=> nrel_main_idtf:
