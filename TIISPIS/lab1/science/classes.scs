=> nrel_note:
	[Наука, направленная на практическое применение знаний] (* <- lang_ru;; *);;

concept_physics
<- sc_node_class;
<= nrel_inclusion: concept_natural_science;
=> nrel_main_idtf:
	[Физика] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Physics] (* <- lang_en;; *);
=> nrel_note:
	[Наука о природных явлениях и строении материи] (* <- lang_ru;; *);;

concept_chemistry
<- sc_node_class;
<= nrel_inclusion: concept_natural_science;
=> nrel_main_idtf:
	[Химия] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Chemistry] (* <- lang_en;; *);
=> nrel_note:
	[Наука о веществах, их строении, свойствах и превращениях] (* <- lang_ru;; *);;

concept_biology
