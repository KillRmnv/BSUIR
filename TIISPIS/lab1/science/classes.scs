<= nrel_inclusion: concept_natural_science;
=> nrel_main_idtf:
	[Биология] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Biology] (* <- lang_en;; *);
=> nrel_note:
	[Наука о живых организмах и их взаимодействии со средой] (* <- lang_ru;; *);;

concept_mathematics
<- sc_node_class;
<= nrel_inclusion: concept_formal_science;
=> nrel_main_idtf:
	[Математика] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Mathematics] (* <- lang_en;; *);
=> nrel_note:
	[Наука о структурах, порядке и отношениях] (* <- lang_ru;; *);;

concept_informatics
<- sc_node_class;
<= nrel_inclusion: concept_formal_science;
=> nrel_main_idtf:
