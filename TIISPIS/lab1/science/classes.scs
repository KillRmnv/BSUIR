// ============================================
// КЛАССЫ предметной области "Наука"
// ============================================

// --- Базовые классы ---

concept_science
<- sc_node_class;
=> nrel_main_idtf:
	[Наука] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Science] (* <- lang_en;; *);
=> nrel_note:
	[Систематизированная деятельность человека, направленная на развитие знаний о мире] (* <- lang_ru;; *);;

concept_research
<- sc_node_class;
=> nrel_main_idtf:
	[Исследование] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Research] (* <- lang_en;; *);
=> nrel_note:
	[Систематическая деятельность для получения новых знаний] (* <- lang_ru;; *);;

concept_experiment
<- sc_node_class;
=> nrel_main_idtf:
	[Эксперимент] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Experiment] (* <- lang_en;; *);
=> nrel_note:
	[Метод познания, заключающийся в воздействии на изучаемый объект] (* <- lang_ru;; *);;

concept_hypothesis
<- sc_node_class;
=> nrel_main_idtf:
	[Гипотеза] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Hypothesis] (* <- lang_en;; *);
=> nrel_note:
	[Предположение, требующее проверки] (* <- lang_ru;; *);;

concept_theory
<- sc_node_class;
=> nrel_main_idtf:
	[Теория] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Theory] (* <- lang_en;; *);
=> nrel_note:
	[Система обобщённых положений, объясняющих определённую область явлений] (* <- lang_ru;; *);;

concept_method
<- sc_node_class;
=> nrel_main_idtf:
	[Метод] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Method] (* <- lang_en;; *);
=> nrel_note:
	[Способ достижения цели, организованная деятельность] (* <- lang_ru;; *);;

concept_law
<- sc_node_class;
=> nrel_main_idtf:
	[Закон научный] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Scientific law] (* <- lang_en;; *);
=> nrel_note:
	[Обобщение эмпирических фактов, выражающее объективную закономерность] (* <- lang_ru;; *);;

concept_discovery
<- sc_node_class;
<= nrel_inclusion: concept_wit_entity;
=> nrel_main_idtf:
	[Открытие] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Discovery] (* <- lang_en;; *);
=> nrel_note:
	[Установление ранее неизвестного научного факта или закона] (* <- lang_ru;; *);;

concept_paradigm
<- sc_node_class;
=> nrel_main_idtf:
	[Парадигма] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Paradigm] (* <- lang_en;; *);
=> nrel_note:
	[Совокупность основных идей и принципов в науке] (* <- lang_ru;; *);;

concept_model
<- sc_node_class;
=> nrel_main_idtf:
	[Модель] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Model] (* <- lang_en;; *);
=> nrel_note:
	[Упрощённое представление объекта или процесса] (* <- lang_ru;; *);;

// --- Субъекты науки ---

concept_scientist
<- sc_node_class;
<= nrel_inclusion: concept_wit_entity;
=> nrel_main_idtf:
	[Учёный] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Scientist] (* <- lang_en;; *);
=> nrel_note:
	[Человек, занимающийся научной деятельностью] (* <- lang_ru;; *);;

concept_institution
<- sc_node_class;
<= nrel_inclusion: concept_wit_entity;
=> nrel_main_idtf:
	[Научное учреждение] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Scientific institution] (* <- lang_en;; *);
=> nrel_note:
	[Организация, осуществляющая научную деятельность] (* <- lang_ru;; *);;

concept_journal
<- sc_node_class;
<= nrel_inclusion: concept_wit_entity;
=> nrel_main_idtf:
	[Научный журнал] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Scientific journal] (* <- lang_en;; *);
=> nrel_note:
	[Периодическое издание, публикующее результаты научных исследований] (* <- lang_ru;; *);;

concept_conference
<- sc_node_class;
<= nrel_inclusion: concept_wit_entity;
=> nrel_main_idtf:
	[Научная конференция] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Scientific conference] (* <- lang_en;; *);
=> nrel_note:
	[Форма организации научной деятельности, обмена опытом] (* <- lang_ru;; *);;

concept_dissertation
<- sc_node_class;
<= nrel_inclusion: concept_wit_entity;
=> nrel_main_idtf:
	[Диссертация] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Dissertation] (* <- lang_en;; *);
=> nrel_note:
	[Научная работа, представленная для получения учёной степени] (* <- lang_ru;; *);;

concept_patent
<- sc_node_class;
=> nrel_main_idtf:
	[Патент] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Patent] (* <- lang_en;; *);
=> nrel_note:
	[Документ, удостоверяющий авторское право на изобретение] (* <- lang_ru;; *);;

// --- Отрасли науки ---

concept_natural_science
<- sc_node_class;
<= nrel_inclusion: concept_science;
=> nrel_main_idtf:
	[Естественная наука] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Natural science] (* <- lang_en;; *);
=> nrel_note:
	[Наука, изучающая природные явления и законы] (* <- lang_ru;; *);;

concept_human_science
<- sc_node_class;
<= nrel_inclusion: concept_science;
=> nrel_main_idtf:
	[Гуманитарная наука] (* <- lang_ru;; *);
=> nrel_main_idtf:
	[Human science] (* <- lang_en;; *);
=> nrel_note:
	[Наука, изучающая человека, общество и культуру] (* <- lang_ru;; *);;

concept_formal_science
<- sc_node_class;
<= nrel_inclusion: concept_science;
=> nrel_main_idtf:
	[Формальная наука] (* <- lang_ru;; *);
=> nrel_main_idtf:
