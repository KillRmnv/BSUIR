@startuml sequence_download
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 12
skinparam defaultFontName DejaVu Sans
skinparam sequenceArrowColor #475569
skinparam sequenceLifeLineBorderColor #94A3B8
skinparam sequenceParticipantBackgroundColor #F1F5F9
skinparam sequenceParticipantBorderColor #64748B

actor "Пользователь" as User
participant "Браузер" as Browser
participant "Flask\n(controllers/documents.py)" as Flask
participant "database_manager.py" as DB
participant "s3_client.py\n(Storage)" as S3
participant "MinIO\nObject Storage" as MinIO

User -> Browser : кликает «Download»
Browser -> Flask : GET /api/documents/<id>/download
Flask -> DB : get_document_by_id(id)
DB -> DB : SELECT id, title, s3_key FROM documents
DB -> S3 : download_text(s3_key)
S3 -> MinIO : GET /<bucket>/<s3_key>
MinIO --> S3 : file bytes (UTF-8 text)
S3 --> DB : text string
DB --> Flask : {s3_key, title, content}
Flask --> Browser : 200 OK\nContent-Type: text/plain;\ncharset=utf-8\nfilename="<title>.txt"
Browser -> User : файл скачивается

@enduml
