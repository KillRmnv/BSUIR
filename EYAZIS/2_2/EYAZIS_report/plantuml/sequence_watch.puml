@startuml sequence_watch
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName DejaVu Sans
skinparam SequenceMessageAlign center
skinparam ParticipantPadding 20

skinparam sequence {
    ArrowColor #475569
    LifeLineBorderColor #94A3B8
    LifeLineBackgroundColor #E2E8F0
    ParticipantBorderColor #EA580C
    ParticipantBackgroundColor #FFF7ED
    ActorBorderColor #D97706
    ActorBackgroundColor #FEF3C7
    DatabaseBorderColor #DB2777
    DatabaseBackgroundColor #FCE7F3
}

actor "Пользователь" as User
box "CLI-клиент (file_watcher/)" #FFF7ED
    participant "watch_client.py\n(watchdog Observer)" as CLI
end box
box "Серверный уровень (Flask)" #DCFCE7
    participant "app.py\n(REST API)" as API
    participant "watch_handler.py" as WH
    participant "document_loader.py" as LOADER
    participant "document_processor.py" as DP
    participant "s3_client.py" as S3
    participant "database_manager.py" as DBM
end box
database "PostgreSQL 16\n+ pgvector" as DB
database "MinIO\nObject Storage" as MINIO

== Запуск клиента ==

User -> CLI : python watch_client.py ./docs\n--server http://localhost:5000
CLI -> CLI : загрузка .watch_state.json\n(если существует)
CLI -> CLI : сканирование директории\n(os.walk)

alt state-файл существует
    CLI -> CLI : сравнение текущих файлов\nс сохранённым состоянием
    note right: Новые файлы → created\nИзменённые → modified\nУдалённые → deleted

    loop для каждого нового/изменённого файла
        CLI -> API : POST /api/watch-event\n{event_type: "created"/"modified",\nfile_path, file_content (base64),\nclient_id}
        API -> WH : handle_watch_event(...)
        WH -> LOADER : extract_text_from_bytes(data, filename)
        LOADER --> WH : текст документа
        WH -> S3 : upload_text(text, s3_key)
        S3 -> MINIO : PUT text to S3
        MINIO --> S3 : OK
        S3 --> WH : OK
        WH -> DP : expand_vocabulary(new_text, all_texts)
        WH -> DP : compute_idf(all_texts + new)
        WH -> DBM : save_vocabulary(), save_idf()
        WH -> DP : generate_summary(text)
        WH -> DP : vectorize_text_with_dim(text, 5000)
        WH -> DBM : upsert_document(title, text,\nembedding, summary, file_path,\ns3_key, lang)
        DBM -> DB : INSERT ... ON CONFLICT\nDO UPDATE
        DB --> DBM : doc_id
        DBM --> WH : doc_id
        WH --> API : {status: "indexed",\ndocument_id, title}
        API --> CLI : HTTP 200
    end

    loop для каждого удалённого файла
        CLI -> API : POST /api/watch-event\n{event_type: "deleted",\nfile_path, client_id}
        API -> WH : handle_watch_event(...)
        WH -> DBM : delete_document_by_path(file_path)
        DBM -> DB : DELETE FROM documents
        WH -> DBM : get_all_document_texts()
        WH -> DP : build_vocabulary() + compute_idf()
        WH -> DBM : save_vocabulary(), save_idf()
        WH --> API : {status: "deleted"}
        API --> CLI : HTTP 200
    end

    CLI -> CLI : обновление .watch_state.json
else state-файл не найден (первый запуск)
    CLI -> CLI : создание .watch_state.json
    note right: Все файлы отправляются\nкак created
end

== Наблюдение (watchdog Observer) ==

CLI -> CLI : Observer.start()\nмониторинг директории

loop пока пользователь не нажал Ctrl+C
    note right: watchdog отслеживает\ncreated / modified / deleted\nсобытия в реальном времени

    alt файл создан или изменён
        CLI -> API : POST /api/watch-event\n{event_type: "created"/"modified",\nfile_path, file_content, client_id}
        API -> WH : handle_watch_event(...)
        WH -> WH : извлечение текста,\nсохранение в MinIO,\nпересчёт vocab/IDF,\nсаммари, векторизация
        WH -> DBM : upsert_document(...,\ns3_key, lang)
        WH --> API : {status: "indexed"}
        API --> CLI : HTTP 200
        CLI -> CLI : обновление .watch_state.json
    else файл удалён
        CLI -> API : POST /api/watch-event\n{event_type: "deleted",\nfile_path, client_id}
        API -> WH : handle_watch_event(...)
        WH -> DBM : delete_document_by_path()
        WH -> WH : пересчёт vocab/IDF
        WH --> API : {status: "deleted"}
        API --> CLI : HTTP 200
        CLI -> CLI : обновление .watch_state.json
    end
end

User -> CLI : Ctrl+C
CLI -> CLI : Observer.stop()

@enduml
