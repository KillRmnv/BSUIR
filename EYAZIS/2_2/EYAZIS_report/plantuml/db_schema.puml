@startuml db_schema
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName DejaVu Sans
skinparam linetype ortho
hide circle

skinparam class {
    BackgroundColor #E0E7FF
    BorderColor #4F46E5
    ArrowColor #475569
    HeaderBackgroundColor #C7D2FE
}

entity "documents" as documents {
    * id : SERIAL <<PK>>
    --
    title : VARCHAR(500)
    date_added : TIMESTAMP
    embedding : vector(5000)
    summary : TEXT
    file_path : VARCHAR(1000) <<UNIQUE>>
    lang : VARCHAR(10)
    s3_key : VARCHAR(500)
}

entity "search_logs" as search_logs {
    * id : SERIAL <<PK>>
    --
    query_text : TEXT
    query_embedding : vector(5000)
    timestamp : TIMESTAMP
}

entity "vocabulary" as vocabulary {
    * id : SERIAL <<PK>>
    --
    word : VARCHAR(255) <<UNIQUE>>
    vector_index : INTEGER
}

entity "idf_values" as idf_values {
    * id : SERIAL <<PK>>
    --
    word : VARCHAR(255) <<UNIQUE>>
    idf_value : DOUBLE PRECISION
}

entity "translation_dictionary\n(PARTITION BY LIST pos_group)" as translation_dict {
    * id : BIGSERIAL <<PK>>
    --
    source_word : VARCHAR(255) <<lowercase>>
    target_word : VARCHAR(255)
    source_pos : VARCHAR(20)
    target_pos : VARCHAR(20)
    pos_group : VARCHAR(10) <<PK>>
    frequency : INTEGER
    UNIQUE(source_word, target_word, source_pos, pos_group)
}

entity "phrase_dictionary" as phrase_dict {
    * id : SERIAL <<PK>>
    --
    source_phrase : VARCHAR(500) <<UNIQUE>>
    target_phrase : VARCHAR(500)
    frequency : INTEGER
}

entity "schema_migrations" as schema_migrations {
    * id : SERIAL <<PK>>
    --
    migration_name : VARCHAR(255) <<UNIQUE>>
    applied_at : TIMESTAMP
}

entity "watch_clients" as watch_clients {
    * id : SERIAL <<PK>>
    --
    client_id : VARCHAR(255) <<UNIQUE>>
    watched_dir : VARCHAR(1000)
    registered_at : TIMESTAMP
    last_seen : TIMESTAMP
}

entity "watch_events" as watch_events {
    * id : SERIAL <<PK>>
    --
    client_id : VARCHAR(255)
    event_type : VARCHAR(50)
    file_path : VARCHAR(1000)
    old_path : VARCHAR(1000)
    timestamp : TIMESTAMP
}

watch_clients ||--o{ watch_events

note bottom of documents
  Текст хранится в S3 (MinIO),
  в БД — только s3_key
end note

note bottom of translation_dict
  Словарь EN->FR: 95 454 пары
  (41 020 уникальных слов).
  Партиции по pos_group:
  noun / verb / adj / adv /
  func / other (маппинг из
  Penn-тега, миграция 009).
  Источники: сид-списки +
  English WordNet x French OMW.
  Индексы (наследуются
  партициями):
  - (source_word, source_pos)
    INCLUDE (...) — покрывающий,
    прунинг партиций;
  - source_word text_pattern_ops
    — префиксный LIKE;
  - GIN gin_trgm_ops — нечёткий
    поиск (опечатки);
  - frequency DESC — пагинация.
  Ключи нормализуются в
  lowercase при записи.
end note

note bottom of phrase_dict
  Словарь переводов
  многословных выражений
end note

@enduml
